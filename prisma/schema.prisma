generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  ADVISOR
}

enum SaleStatus {
  PENDIENTE
  INSTALADA
  RECHAZADA
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  city      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]
  sales     Sale[]

  @@map("branches")
}

// Compatibility-only representation of the legacy physical table.
// Claro OfferDesk promotions remain static in code and do not query this model.
model PromotionCompatibility {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  title       String
  category    String?
  description String?
  price       String?
  benefits    Json?
  conditions  Json?
  validity    String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("promotions")
}

model User {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String         @unique
  username           String         @unique
  dni                String?        @unique
  passwordHash       String         @map("password_hash")
  fullName           String         @map("full_name")
  branchName         String?        @map("branch_name")
  branchId           String?        @map("branch_id") @db.Uuid
  role               UserRole?
  photoUrl           String?        @map("photo_url")
  isAdmin            Boolean        @default(false) @map("is_admin")
  isActive           Boolean        @default(true) @map("is_active")
  mustChangePassword Boolean        @default(true) @map("must_change_password")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  branch             Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  rankings           SalesRanking[]
  advisorSales       Sale[]          @relation("SaleAdvisor")
  registeredSales    Sale[]          @relation("SaleRegisteredBy")

  @@index([branchId, role, isActive])
  @@map("users")
}

/// PostgreSQL also enforces that rejected sales have a non-empty reason and
/// that non-rejected sales keep rejection_reason null.
model Sale {
  id                String     @id @default(uuid()) @db.Uuid
  advisorId         String     @map("advisor_id") @db.Uuid
  branchId          String     @map("branch_id") @db.Uuid
  registeredById    String     @map("registered_by_id") @db.Uuid
  customerName      String     @map("customer_name")
  customerDni       String     @map("customer_dni")
  customerPhone     String     @map("customer_phone")
  customerEmail     String?    @map("customer_email")
  customerAddress   String?    @map("customer_address")
  service           String
  planName          String?    @map("plan_name")
  status            SaleStatus @default(PENDIENTE)
  rejectionReason   String?    @map("rejection_reason")
  saleDate          DateTime   @map("sale_date") @db.Date
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  advisor           User       @relation("SaleAdvisor", fields: [advisorId], references: [id], onDelete: Restrict)
  branch            Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  registeredBy      User       @relation("SaleRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)

  @@index([advisorId, status, saleDate(sort: Desc)])
  @@index([branchId, status, saleDate(sort: Desc)])
  @@index([status, saleDate(sort: Desc)])
  @@map("sales")
}

model SalesRanking {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodLabel  String   @map("period_label")
  rankPosition Int      @map("rank_position")
  userId       String?  @map("user_id") @db.Uuid
  fullName     String   @map("full_name")
  branchName   String?  @map("branch_name")
  photoUrl     String?  @map("photo_url")
  salesCount   Int      @default(0) @map("sales_count")
  pendingSales Int      @default(0) @map("pending_sales")
  rejectedSales Int     @default(0) @map("rejected_sales")
  note         String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("sales_ranking")
}

/// PostgreSQL also enforces training_media_media_type_check and an updated_at trigger.
model TrainingMedia {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  mediaType   String   @map("media_type")
  fileUrl     String   @map("file_url")
  fileKey     String?  @map("file_key")
  weekLabel   String?  @map("week_label")
  isFeatured  Boolean  @default(false) @map("is_featured")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("training_media")
}
